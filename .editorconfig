root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,mm,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Historical evidence and upstream notices retain their original bytes.
[docs/history/**]
trim_trailing_whitespace = false

[MSU2_MINI_CPP_v0_2_20261010/**]
trim_trailing_whitespace = false
